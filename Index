<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KOPI LANGIT TRANS</title>
    <link rel="icon" type="image/png" href="kopilangittrans.webp">
    <style>
        body, html {
            margin: 0;
            padding: 0;
            height: 100%;
            overflow: hidden;
            background-color: #f4f6f9; /* Warna dasar elegan */
        }
        iframe {
            width: 100%;
            height: 100%;
            border: none;
        }
    </style>
</head>
<body>
    <iframe id="app-frame" title="PINTU LANGIT TRANS"></iframe>

    <script>
        // Masukkan URL Google Apps Script Anda di sini
        const urlGAS = "https://script.google.com/macros/u/1/s/AKfycbyUMI7NJi19pz598yfQNtu0C3DgqGzEqOb-GxLRZemHzwTBK9Q-if4aSCPnxOE7i22G/exec";

        // 2. TEKNIK DYNAMIC REPLACE
        // Memuat iframe menggunakan location.replace agar browser TIDAK merekamnya ke dalam History
        document.getElementById('app-frame').contentWindow.location.replace(urlGAS);

        // 3. TEKNIK HISTORY PUSH STATE (MENJEBAK TOMBOL BACK)
        // Memaksa browser untuk menimpa riwayat tab ini dengan URL Vercel yang sama
        window.history.pushState(null, "", window.location.href);
        
        // Ketika pengguna menekan tombol "Back" (kembali) di browser atau HP
        window.onpopstate = function() {
            // Paksa kembalikan URL ke posisi semula (URL Vercel Anda)
            window.history.pushState(null, "", window.location.href);
        };
    </script>
</body>
</html>
